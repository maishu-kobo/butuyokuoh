# Server-only photo-capture keys. Names only. Do not prefix with NEXT_PUBLIC_.
# Put real values in the process environment, or in a regular file outside this
# repository (mode 0600, owned by the server user) and point CAPTURE_SECRETS_FILE at it.
# Missing keys make that service unavailable and the app falls back to manual entry.

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
YAHOO_SHOPPING_APP_ID=
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=
RAKUTEN_AFFILIATE_ID=
AMAZON_ASSOCIATE_TAG=
# Optional photo guess. Read only when CAPTURE_AI_MODEL is gemini, gemini-lite,
# gemini-ladder, gemini-lite-ladder, or llama4-gemini-fallback.
# Not read from CAPTURE_SECRETS_FILE. AQ. keys are accepted. Off unless selected.
# GEMINI_API_KEY=
# GEMINI_MODEL=
