    },
    {
      "rule": "js/user-controlled-bypass",
      "path": "src/app/api/oauth/consent/route.ts",
      "line": "    if (!pendingId || !decision) {",
      "reason": "空の pending_id / decision を 400 で拒否するだけ。許可は CSRF 一致と会員セッションの後"
    },
    {
      "rule": "js/user-controlled-bypass",
      "path": "src/app/oauth/authorize/route.ts",
      "line": "    if (!resource) {",
      "reason": "resource 欠落を 400 で拒否するだけ。認可コード発行は同意と CSRF・PKCE の後"
    }
