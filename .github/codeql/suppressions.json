{
  "suppressions": [
    {
      "rule": "js/incomplete-url-substring-sanitization",
      "path": "src/lib/product-html.ts",
      "line": "    const isShopify = html.includes('cdn.shopify.com') || html.includes('Shopify.theme');",
      "reason": "ページ本文から価格の単位を選ぶだけ。URL の許可判定ではない"
    },
    {
      "rule": "js/user-controlled-bypass",
      "path": "src/app/api/auth/login/route.ts",
      "line": "    if (!normalizedEmail || !password) {",
      "reason": "空のメールかパスワードを 400 で拒否するだけ。トークンは後段の検証成功後に出す"
    },
    {
      "rule": "js/request-forgery",
      "path": "src/lib/member-fetch.ts",
      "line": "    const req = (url.protocol === 'https:' ? httpsRequest : httpRequest)(options, (response) => {",
      "reason": "接続前に resolvedPublicAddress / isPublicAddress で非公開アドレスを拒否する。任意の公開 URL を受け付ける設計（#267）"
    },
    {
      "rule": "js/request-forgery",
      "path": "src/lib/public-page.ts",
      "line": "    const req = (url.protocol === 'https:' ? httpsRequest : httpRequest)(options, response => {",
      "reason": "接続前に publicAddress / isPublicAddress で非公開アドレスを拒否する。任意の公開 URL を受け付ける設計（#267）"
    },
    {
      "rule": "js/request-forgery",
      "path": "src/lib/scraper.ts",
      "line": "    await page.goto(navigationUrl, { waitUntil: 'networkidle2', timeout: 30000 });",
      "reason": "ホストは AMAZON_DOMAINS 定数。遷移前に resolvedPublicAddress と request 拦截で非公開を拒否する（#267）"
    },
    {
      "rule": "js/insufficient-password-hash",
      "path": "src/lib/agent-token.ts",
      "line": "  return createHash('sha256').update(plaintext, 'utf8').digest('hex');",
      "reason": "ユーザーパスワードではない。高エントロピーの byoagt_ アクセストークン照合用（#268）。OAuth 経由の誤検知。bcrypt は不適切"
    },
    {
      "rule": "js/user-controlled-bypass",
      "path": "src/app/api/oauth/consent/route.ts",
      "line": "  if (pendingId.length < 8 || decision === null || csrf.length < 8) {",
      "reason": "同意入力の形式チェックで 400。許可は CSRF 一致と会員セッションの後"
    }
  ]
}
